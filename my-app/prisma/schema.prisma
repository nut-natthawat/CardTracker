generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id          String         @id @default(uuid())
  name        String
  series      String         
  imageUrl    String?        @unique  
  cardNumber  String?        
  currentPrice Float @default(0)
  prices      PriceHistory[] 
  rarity String? @default("Base")
  createdAt   DateTime       @default(now())
}

model PriceHistory {
  id          String   @id @default(uuid())
  price       Float    
  sourceUrl   String?  
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

// เพิ่มตารางนี้เข้าไปด้านล่างของไฟล์
model SeriesInfo {
  id          String   @id @default(uuid())
  seriesCode  String   @unique 
  name        String   
  boxImageUrl String?  
  packImageUrl String? 
  boxPrice    Float    @default(0) 
  packPrice   Float    @default(0) 
  updatedAt   DateTime @updatedAt
}